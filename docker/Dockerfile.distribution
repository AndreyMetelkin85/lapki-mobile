FROM nginx:stable-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94

# Доставка проверенного APK, а не Android-эмулятор или сервер Expo.
ARG SECURITY_UPDATE_EPOCH=local
ARG APK_VERSION=0.1.3
ARG APK_SHA256=fd0c0ca712c72aa416cf5e8d2d1fa3ce3419e2050402b277af4248ec8c71ccb6
RUN apk upgrade --no-cache \
    && rm -rf /usr/share/nginx/html/* \
    && wget -q -O /usr/share/nginx/html/lapki-android.apk \
       "https://github.com/AndreyMetelkin85/lapki-mobile/releases/download/v${APK_VERSION}/lapki-android.apk" \
    && echo "${APK_SHA256}  /usr/share/nginx/html/lapki-android.apk" | sha256sum -c - \
    && printf '%s  lapki-android.apk\n' "${APK_SHA256}" > /usr/share/nginx/html/lapki-android.apk.sha256 \
    && printf '{"version":"%s","androidAbi":"x86_64","sha256":"%s","apk":"lapki-android.apk"}\n' \
       "${APK_VERSION}" "${APK_SHA256}" > /usr/share/nginx/html/release.json

COPY docker/distribution/nginx.conf /etc/nginx/nginx.conf
COPY docker/distribution/index.html /usr/share/nginx/html/index.html
COPY docker/distribution/style.css /usr/share/nginx/html/style.css

LABEL org.opencontainers.image.title="Лапки Android APK" \
      org.opencontainers.image.source="https://github.com/AndreyMetelkin85/lapki-mobile" \
      org.opencontainers.image.version="${APK_VERSION}" \
      io.lapki.android.abi="x86_64" \
      io.lapki.apk.sha256="${APK_SHA256}"

USER nginx
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
