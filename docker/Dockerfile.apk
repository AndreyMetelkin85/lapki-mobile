FROM eclipse-temurin:17-jdk-jammy AS java
FROM node:22-bookworm-slim AS build
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk ANDROID_HOME=/opt/android-sdk ANDROID_SDK_ROOT=/opt/android-sdk CI=1
ENV PATH="${JAVA_HOME}/bin:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip python3 make g++ git && rm -rf /var/lib/apt/lists/*
ARG ANDROID_TOOLS=commandlinetools-linux-16111833_latest.zip
ARG ANDROID_TOOLS_SHA1=e025545c62a8e64c7559119566a569fb1dec5f60
RUN curl -fL --retry 3 "https://dl.google.com/android/repository/${ANDROID_TOOLS}" -o /tmp/tools.zip \
    && echo "${ANDROID_TOOLS_SHA1}  /tmp/tools.zip" | sha1sum -c - \
    && mkdir -p "${ANDROID_HOME}/cmdline-tools" \
    && unzip -q /tmp/tools.zip -d "${ANDROID_HOME}/cmdline-tools" \
    && mv "${ANDROID_HOME}/cmdline-tools/cmdline-tools" "${ANDROID_HOME}/cmdline-tools/latest" \
    && rm /tmp/tools.zip
RUN yes | sdkmanager --licenses > /dev/null
RUN sdkmanager "platform-tools" "platforms;android-36" "build-tools;36.0.0" "ndk;27.1.12297006" "cmake;3.22.1"
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG API_BASE_URL=http://10.0.2.2:8080/api/v3
ENV EXPO_PUBLIC_API_BASE_URL=${API_BASE_URL}
RUN npx expo prebuild --platform android --no-install
ARG ANDROID_ARCH=x86_64
RUN --mount=type=cache,id=lapki-android-gradle,target=/root/.gradle \
    cd android && chmod +x gradlew && ./gradlew --no-daemon --build-cache assembleRelease \
    -PreactNativeArchitectures="${ANDROID_ARCH}" -Dorg.gradle.jvmargs="-Xmx3g -XX:MaxMetaspaceSize=1g" --max-workers=2
RUN "${ANDROID_HOME}/build-tools/36.0.0/apksigner" verify android/app/build/outputs/apk/release/app-release.apk
FROM scratch AS artifact
COPY --from=build /app/android/app/build/outputs/apk/release/app-release.apk /lapki-android.apk
